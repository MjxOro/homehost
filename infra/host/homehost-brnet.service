# Tenant IPv6 gateway on incusbr0. Installed with homehost-brnet.timer; see
# infra/host/README.md ("Tenant IPv6 gateway") and docs/networking.md.
[Unit]
Description=Homehost tenant bridge IPv6 gateway
After=incus.service wg-quick@r64lan.service sys-subsystem-net-devices-incusbr0.device

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/homehost-brnet /home/mjxoro/projects/homehost/infra/private/worker.env
# The timer runs this every 30s: keep the journal to repairs and failures.
LogLevelMax=notice

[Install]
# Re-run on every Incus (re)start, which disables IPv6 on the bridge.
WantedBy=multi-user.target incus.service
