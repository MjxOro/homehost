{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "types": [
      "vite/client",
      "node"
    ],
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}