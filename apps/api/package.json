{
  "name": "@homehost/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "bun dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "bun --env-file=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@homehost/shared": "0.1.0",
    "drizzle-orm": "^0.45.2",
    "effect": "3.22.2",
    "fastify": "^5.0.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
