# Dev environment (host-side defaults; compose overrides DATABASE_URL/PORT inside containers).
# Copy to .env.dev and fill the blanks. Add this callback URL to the GitHub OAuth app:
#   http://127.0.0.1:5174/api/auth/callback/github
DATABASE_URL=postgres://homehost:homehost@127.0.0.1:55433/homehost
APP_ORIGIN=http://127.0.0.1:5174
SHOWCASE_MODE=false
OPERATOR_EMAILS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
IPV6_PREFIX=
CF_DNS_API_TOKEN=
