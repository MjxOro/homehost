# Dev environment (host-side defaults; compose overrides DATABASE_URL/PORT inside containers).
# Copy to .env.dev and fill the blanks.
#
# APP_ORIGIN picks which host can log in (OAuth callback + mutation allowlist):
#   http://127.0.0.1:5174  (+ callback http://127.0.0.1:5174/api/auth/callback/github)
# APP_EXTRA_ORIGINS (comma-separated) additionally allows mutations from the
# LAN address when the stack is started with DEV_BIND_IP (see
# infra/dev/compose.yml). OAuth redirects still use APP_ORIGIN. The dev stack
# is LAN-only: never put a public hostname here.
DATABASE_URL=postgres://homehost:homehost@127.0.0.1:55433/homehost
APP_ORIGIN=http://127.0.0.1:5174
SHOWCASE_MODE=true
OPERATOR_EMAILS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
IPV6_PREFIX=2a11:6c7:f35:ea
# Dev Cloudflare token: copy CF_DNS_API_TOKEN from infra/private/traefik.env
# (same zone, DNS:Edit scope). Empty = worker skips ALL AAAA writes (SSH +
# desktop) but still provisions VMs + writes Traefik route files.
CF_DNS_API_TOKEN=
# Worker env scoping: dev compose worker only leases *.dev rows; prod/host
# worker (empty WORKER_BASE_DOMAIN) never touches them.
#WORKER_ENV=dev
#WORKER_BASE_DOMAIN=dev.homehost.risktozero.sh
# Concierge ("What do you want to run?"): OpenRouter key for Jev + the
# translation fallback. Empty = the helper hides itself (API answers 503).
OPENROUTER_API_KEY=
