{
  "name": "homehost",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "bun --env-file=.env --watch apps/api/src/server.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "db:migrate": "bun --env-file=.env apps/api/src/db/migrate.ts",
    "db:up": "docker compose -f infra/compose.yml up -d --wait",
    "db:down": "docker compose -f infra/compose.yml down",
    "host:check": "bash infra/host/check.sh",
    "dev:up": "docker compose -f infra/dev/compose.yml up -d --wait",
    "dev:down": "docker compose -f infra/dev/compose.yml down",
    "dev:logs": "docker compose -f infra/dev/compose.yml logs -f",
    "dev:reset": "docker compose -f infra/dev/compose.yml down -v",
    "dev:migrate": "bun --env-file=.env.dev apps/api/src/db/migrate.ts",
    "prod:build": "TAG=$(git rev-parse --short HEAD) docker compose -f infra/prod/compose.yml build",
    "prod:up": "TAG=$(git rev-parse --short HEAD) docker compose -f infra/prod/compose.yml up -d --wait",
    "prod:down": "docker compose -f infra/prod/compose.yml down",
    "prod:logs": "docker compose -f infra/prod/compose.yml logs -f",
    "prod:deploy": "git fetch origin && git checkout -q main && git pull --ff-only && bun run prod:build && bun run prod:up",
    "host:setup": "bash infra/host/setup-incus.sh",
    "worker": "bun apps/worker/src/index.ts",
    "test": "bun test packages/shared",
    "test:integration": "SHOWCASE_MODE=true DATABASE_URL=$TEST_DATABASE_URL bun test apps/api/test",
    "test:reset": "bun scripts/test-reset.ts",
    "format": "prettier --write apps packages docs README.md package.json tsconfig.base.json infra/compose.yml",
    "format:check": "prettier --check apps packages docs README.md package.json tsconfig.base.json infra/compose.yml",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '@homehost/api' --filter '@homehost/web' build"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "prettier": "^3.6.0"
  }
}
