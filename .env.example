# Local showcase only. Never reuse these credentials for a public deployment.
SHOWCASE_MODE=true
DATABASE_URL=postgres://homehost:homehost@127.0.0.1:55432/homehost
HOST=127.0.0.1
PORT=3000
BASE_DOMAIN=lab.example.test
API_PROXY_TARGET=http://127.0.0.1:3000
APP_ORIGIN=http://127.0.0.1:5173

# GitHub OAuth (optional). Create an OAuth App at
# github.com/settings/developers with callback
# http://127.0.0.1:5173/api/auth/callback/github, then fill these in .env.
# OPERATOR_EMAILS is required when any provider is set (comma-separated,
# must match your GitHub primary verified email for the operator role).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OPERATOR_EMAILS=

# Public IPv6 /64 routed to this host (tunnel broker). The worker derives one
# stable address per box and publishes its AAAA. Empty disables v6.
IPV6_PREFIX=

# Cloudflare API token for per-box AAAA records (worker) and Traefik DNS-01
# (panel edge). "Edit zone DNS" template, scoped to the zone. Empty disables
# DNS writes; the showcase needs none of this.
CF_DNS_API_TOKEN=
